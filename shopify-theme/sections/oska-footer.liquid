<footer class="oska-footer">
  <div class="oska-footer__grid">
    <div>
      <a class="oska-brand" href="{{ routes.root_url }}">OSKA</a>
      <p>{{ section.settings.tagline }}</p>
    </div>
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <strong>{{ block.settings.heading }}</strong>
        {% for link in block.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</footer>
{% schema %}
{"name":"OSKA Footer","settings":[{"type":"textarea","id":"tagline","label":"Tagline","default":"Premium B2B jewellery development and catalogue experience."}],"blocks":[{"type":"menu","name":"Menu column","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"link_list","id":"menu","label":"Menu"}]}],"max_blocks":4}
{% endschema %}