<section class="oska-service">
  <div>
    <div class="oska-eyebrow">CONCIERGE / B2B</div>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="oska-service__links">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"OSKA B2B Concierge","settings":[{"type":"text","id":"heading","label":"Heading","default":"At your service"}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","id":"label","label":"Label"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":5,"presets":[{"name":"OSKA B2B Concierge","blocks":[{"type":"service"},{"type":"service"},{"type":"service"},{"type":"service"},{"type":"service"}]}]}
{% endschema %}