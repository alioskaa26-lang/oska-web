        <a href="#all-collections">{% if tr %}TÜM KOLEKSİYONLAR{% else %}ALL COLLECTIONS{% endif %}</a>
        <a href="#selection-2026">{% if tr %}2026 SEÇKİSİ{% else %}2026 SELECTION{% endif %}</a>
      </div>
    </div>
    <div class="oska-chub__hero-media"><img src="{{ 'mesh-silver.jpeg' | asset_url }}" alt="OSKA Mesh collection" fetchpriority="high"></div>
