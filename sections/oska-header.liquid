<div id="oska-google-translate" class="oska-google-translate" aria-hidden="true"></div>
<script>
(function(){
  const map={tr:'tr',en:'en'};
  window.oskaGoogleTranslateInit=function(){
    if(window.google&&google.translate){
      new google.translate.TranslateElement({pageLanguage:'tr',includedLanguages:'tr,en',autoDisplay:false},'oska-google-translate');
    }
  };
  function setTranslatedLanguage(lang){
    const nativeTR='{{ oska_tr_url }}', nativeEN='{{ oska_en_url }}';
    if(lang==='tr'){ location.assign(nativeTR); return; }
    if(lang==='en'){ location.assign(nativeEN); return; }
    const tryCombo=()=>{
      const combo=document.querySelector('.goog-te-combo');
      if(combo){combo.value=map[lang]||lang;combo.dispatchEvent(new Event('change'));document.documentElement.lang=lang;return true}
      return false;
    };
    if(!tryCombo()) setTimeout(tryCombo,700);
  }
  function detectFromText(text){
    if(/[\u0400-\u04FF]/.test(text))return'ru';
    if(/[\u0600-\u06FF]/.test(text))return'ar';
    if(/[\u4E00-\u9FFF]/.test(text))return'zh-CN';
    if(/[ñ¿¡]/i.test(text))return'es';
    return null;
  }
  document.addEventListener('click',function(e){
    const b=e.target.closest('[data-oska-lang]');
    if(!b)return;
    setTranslatedLanguage(b.dataset.oskaLang);
  });
  const mic=document.querySelector('[data-oska-language-mic]');
  const status=document.querySelector('[data-oska-language-status]');
  const avatar=document.querySelector('[data-oska-language-avatar]');
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(mic){
    mic.addEventListener('click',function(){
      if(!SR){if(status)status.textContent='Voice recognition is unavailable in this browser.';return}
      const rec=new SR();
      rec.lang=(navigator.languages&&navigator.languages[0])||document.documentElement.lang||'tr-TR';
      rec.interimResults=false;rec.continuous=false;
      if(status)status.textContent='Listening… / Dinliyorum…';
      avatar?.classList.add('is-listening');
      rec.onresult=function(ev){
        const text=ev.results?.[0]?.[0]?.transcript||'';
        const detected=detectFromText(text);
        if(status)status.textContent=text;
        if(detected)setTranslatedLanguage(detected);
        avatar?.classList.remove('is-listening');avatar?.classList.add('is-speaking');
        setTimeout(()=>avatar?.classList.remove('is-speaking'),1400);
      };
      rec.onerror=function(){if(status)status.textContent='Dilinizi aşağıdan seçebilirsiniz. / Choose your language below.';avatar?.classList.remove('is-listening')};
      rec.onend=function(){avatar?.classList.remove('is-listening')};
      try{rec.start()}catch(err){}
    });
  }
})();
</script>
