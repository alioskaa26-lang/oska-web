{% assign tr=false %}{% if request.locale.iso_code == 'tr' %}{% assign tr=true %}{% endif %}
{% assign oska_has_tr = false %}
{% assign oska_has_en = false %}
{% for language in localization.available_languages %}
  {% if language.iso_code == 'tr' %}{% assign oska_has_tr = true %}{% endif %}
  {% if language.iso_code == 'en' %}{% assign oska_has_en = true %}{% endif %}
{% endfor %}
{% assign oska_route = request.path %}
{% assign oska_route_prefix = oska_route | slice: 0, 4 %}
{% if oska_route == '/tr' or oska_route == '/en' %}
  {% assign oska_route = '/' %}
{% elsif oska_route_prefix == '/tr/' %}
  {% assign oska_route = oska_route | remove_first: '/tr' %}
{% elsif oska_route_prefix == '/en/' %}
  {% assign oska_route = oska_route | remove_first: '/en' %}
{% endif %}
{% assign oska_tr_url = oska_route %}
{% if oska_route == '/' %}
  {% assign oska_en_url = '/en' %}
{% else %}
  {% assign oska_en_url = '/en' | append: oska_route %}
{% endif %}

