{% assign tr = false %}{% if request.locale.iso_code == 'tr' %}{% assign tr = true %}{% endif %}
<section class="oska-info">
{% case page.handle %}
{% when 'collections' %}
  <div class="oska-info__hero"><div class="oska-eyebrow">{% if tr %}KATALOG{% else %}CATALOGUE{% endif %}</div><h1>{% if tr %}Koleksiyonlar{% else %}Collections{% endif %}</h1><p class="oska-info__lead">{% if tr %}Kadın ve erkek kategorilerini, imza bileklikleri ve üretim yönlerini tek merkezden keşfedin.{% else %}Explore women’s and men’s categories, signature bracelets and production directions from one place.{% endif %}</p></div>
  <div class="oska-category-grid">
    <a class="oska-category-card" href="/pages/women-collections"><img src="{{ 'oska-025.jpg' | asset_img_url: '1200x' }}" alt=""><span class="oska-category-card__overlay"></span><div class="oska-category-card__copy"><div class="oska-eyebrow">WOMEN</div><h3>{% if tr %}Kadın{% else %}Women{% endif %}</h3></div></a>
    <a class="oska-category-card" href="/pages/men-collections"><img src="{{ 'oska-055.jpg' | asset_img_url: '1200x' }}" alt=""><span class="oska-category-card__overlay"></span><div class="oska-category-card__copy"><div class="oska-eyebrow">MEN</div><h3>{% if tr %}Erkek{% else %}Men{% endif %}</h3></div></a>
    <a class="oska-category-card" href="/pages/contact-rfq?ref=PANTHER"><img src="{{ 'aa126-card.jpg' | asset_img_url: '1200x' }}" alt=""><span class="oska-category-card__overlay"></span><div class="oska-category-card__copy"><div class="oska-eyebrow">SIGNATURE</div><h3>Panther</h3></div></a>
    <a class="oska-category-card" href="/pages/contact-rfq?ref=MESH"><img src="{{ 'mesh-silver.jpeg' | asset_img_url: '1200x' }}" alt=""><span class="oska-category-card__overlay"></span><div class="oska-category-card__copy"><div class="oska-eyebrow">SIGNATURE</div><h3>Mesh</h3></div></a>
  </div>
{% when 'manufacturing' %}
  <div class="oska-info__hero"><div class="oska-eyebrow">{% if tr %}ÜRETİM{% else %}MANUFACTURING{% endif %}</div><h1>{% if tr %}Fikirden üretime kontrollü süreç{% else %}A controlled path from concept to production{% endif %}</h1><p class="oska-info__lead">{% if tr %}OSKA; 925 gümüş, pirinç, altın kaplama, taş yerleşimi, CAD geliştirme ve özel üretim projelerinde İstanbul merkezli üretim kabiliyeti sunar.{% else %}OSKA provides Istanbul-based production capability across sterling silver, brass, gold plating, stone setting, CAD development and bespoke production projects.{% endif %}</p></div>
  <div class="oska-info__grid"><div class="oska-info__card"><h3>CAD & 3D</h3><p>{% if tr %}Tasarım yönünün teknik modele dönüştürülmesi ve üretilebilirlik kontrolü.{% else %}Turning design direction into technical models with manufacturability checks.{% endif %}</p></div><div class="oska-info__card"><h3>{% if tr %}Numune{% else %}Sampling{% endif %}</h3><p>{% if tr %}Malzeme, ölçü ve yüzey kararlarının sipariş öncesi doğrulanması.{% else %}Validating material, sizing and finish decisions before production.{% endif %}</p></div><div class="oska-info__card"><h3>QC</h3><p>{% if tr %}Proje bazlı kalite kontrol ve siparişe göre üretim planı.{% else %}Project-based quality control and order-specific production planning.{% endif %}</p></div></div>
{% when 'private-label' %}
  <div class="oska-info__hero"><div class="oska-eyebrow">PRIVATE LABEL / OEM</div><h1>{% if tr %}Markanız için üretim ortağı{% else %}A production partner for your brand{% endif %}</h1><p class="oska-info__lead">{% if tr %}Koleksiyon geliştirme, prototip, materyal seçimi, yüzey, taş ve seri üretim akışı tek proje altında yönetilebilir.{% else %}Collection development, prototyping, materials, finishes, stones and production can be managed in one project flow.{% endif %}</p></div>
  <div class="oska-info__grid"><div class="oska-info__card"><h3>{% if tr %}Tasarım geliştirme{% else %}Design development{% endif %}</h3><p>{% if tr %}Referans, eskiz veya mevcut ürün üzerinden yeni varyasyonlar.{% else %}New variations from references, sketches or existing products.{% endif %}</p></div><div class="oska-info__card"><h3>{% if tr %}Esnek adet{% else %}Flexible quantities{% endif %}</h3><p>{% if tr %}MOQ ve termin proje bazında netleştirilir.{% else %}MOQ and lead time are confirmed per project.{% endif %}</p></div><div class="oska-info__card"><h3>{% if tr %}Marka uygulaması{% else %}Brand application{% endif %}</h3><p>{% if tr %}Logo, ambalaj ve ürün kimliği gereksinimleri sipariş kapsamında değerlendirilebilir.{% else %}Logo, packaging and product identity requirements can be reviewed within the project scope.{% endif %}</p></div></div>
{% else %}
  <div class="oska-info__hero"><div class="oska-eyebrow">OSKA</div><h1>{% if tr %}İstanbul merkezli takı tasarım ve üretim{% else %}Jewelry design and production from Istanbul{% endif %}</h1><p class="oska-info__lead">{% if tr %}OSKA, modern ve güçlü takı tasarımlarını B2B, private label ve özel üretim ihtiyaçlarıyla buluşturan İstanbul merkezli bir üretim yapısıdır.{% else %}OSKA is an Istanbul-based production house connecting modern, substantial jewelry design with B2B, private-label and bespoke production needs.{% endif %}</p></div>
  <div class="oska-info__grid"><div class="oska-info__card"><h3>{% if tr %}Malzemeler{% else %}Materials{% endif %}</h3><p>925 sterling silver · brass · gold plated · stone setting</p></div><div class="oska-info__card"><h3>{% if tr %}Geliştirme{% else %}Development{% endif %}</h3><p>CAD · 3D · prototyping · bespoke variations</p></div><div class="oska-info__card"><h3>B2B</h3><p>{% if tr %}Toptan, private label ve marka üretim projeleri.{% else %}Wholesale, private-label and brand production projects.{% endif %}</p></div></div>
{% endcase %}
</section>
{% schema %}{"name":"OSKA Info Page","settings":[]}{% endschema %}