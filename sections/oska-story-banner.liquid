{% assign tr=false %}{% if request.locale.iso_code == 'tr' %}{% assign tr=true %}{% endif %}
<section class="oska-story">
  {% if section.settings.video_asset != blank %}<video data-oska-autoplay loop muted playsinline preload="none" aria-hidden="true" tabindex="-1"><source src="{{ section.settings.video_asset | asset_url }}" type="video/mp4"></video>{% else %}<img src="{{ section.settings.image_asset | asset_img_url: '1600x' }}" alt="" loading="lazy" decoding="async">{% endif %}
  <div class="oska-story-copy"><div class="oska-eyebrow">{% if tr %}{{ section.settings.eyebrow_tr }}{% else %}{{ section.settings.eyebrow_en }}{% endif %}</div><h2>{% if tr %}{{ section.settings.title_tr }}{% else %}{{ section.settings.title_en }}{% endif %}</h2><p>{% if tr %}{{ section.settings.body_tr }}{% else %}{{ section.settings.body_en }}{% endif %}</p><a class="oska-button oska-button--light" href="{{ section.settings.link }}">{% if tr %}{{ section.settings.button_tr }}{% else %}{{ section.settings.button_en }}{% endif %}</a></div>
</section>
{% schema %}
{"name":"OSKA Story Banner","settings":[{"type":"text","id":"image_asset","label":"Theme image asset"},{"type":"text","id":"video_asset","label":"Theme video asset"},{"type":"text","id":"eyebrow_tr","label":"Eyebrow TR"},{"type":"text","id":"eyebrow_en","label":"Eyebrow EN"},{"type":"text","id":"title_tr","label":"Title TR"},{"type":"text","id":"title_en","label":"Title EN"},{"type":"textarea","id":"body_tr","label":"Body TR"},{"type":"textarea","id":"body_en","label":"Body EN"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"button_tr","label":"Button TR","default":"KEŞFET"},{"type":"text","id":"button_en","label":"Button EN","default":"DISCOVER"}],"presets":[{"name":"OSKA Story Banner"}]}
{% endschema %}