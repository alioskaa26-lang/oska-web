<section style="padding:24px;background:#fff;color:#111"><h1 style="font-family:Arial;font-size:28px;margin:0 0 20px">OSKA Asset Audit 001–081</h1><div style="display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px">{% for i in (1..81) %}{% assign n=i | prepend:'000' | slice:-3,3 %}{% assign f='oska-' | append:n | append:'.jpg' %}<figure style="margin:0;border:1px solid #ddd;padding:6px"><img src="{{ f | asset_url }}" alt="OSKA {{ n }}" style="width:100%;aspect-ratio:1/1;object-fit:contain;background:#fafafa"><figcaption style="font:12px Arial;margin-top:5px">OSKA-{{ n }}</figcaption></figure>{% endfor %}</div></section>{% schema %}{"name":"OSKA Asset Audit","settings":[]}{% endschema %}