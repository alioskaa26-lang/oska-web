{% assign tr=false %}{% if request.locale.iso_code == 'tr' %}{% assign tr=true %}{% endif %}
<section class="oska-more"><div class="oska-home-heading"><div class="oska-eyebrow">{% if tr %}DAHA FAZLASINI KEŞFET{% else %}MORE TO EXPLORE{% endif %}</div><h2>{% if tr %}OSKA Dünyası{% else %}The World of OSKA{% endif %}</h2></div><div class="oska-more-grid">{% for block in section.blocks %}<a class="oska-more-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><div class="oska-more-media"><img src="{{ block.settings.asset_name | asset_img_url: '1200x' }}" alt="{% if tr %}{{ block.settings.title_tr | escape }}{% else %}{{ block.settings.title_en | escape }}{% endif %}" loading="lazy" decoding="async"></div><h3>{% if tr %}{{ block.settings.title_tr }}{% else %}{{ block.settings.title_en }}{% endif %}</h3><p>{% if tr %}{{ block.settings.body_tr }}{% else %}{{ block.settings.body_en }}{% endif %}</p></a>{% endfor %}</div></section>
{% schema %}{"name":"OSKA More Explore","blocks":[{"type":"item","name":"Explore card","settings":[{"type":"text","id":"asset_name","label":"Theme asset filename"},{"type":"text","id":"title_tr","label":"Title TR"},{"type":"text","id":"title_en","label":"Title EN"},{"type":"text","id":"body_tr","label":"Body TR"},{"type":"text","id":"body_en","label":"Body EN"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":6,"presets":[{"name":"OSKA More Explore"}]}{% endschema %}