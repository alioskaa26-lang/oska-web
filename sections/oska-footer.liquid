{% assign tr=false %}{% if request.locale.iso_code == 'tr' %}{% assign tr=true %}{% endif %}
{{ 'oska-footer.css' | asset_url | stylesheet_tag }}
<footer class="oska-premium-footer" role="contentinfo">
  <div class="oska-premium-footer__inner">
    <div class="oska-premium-footer__main">
      <div class="oska-premium-footer__columns">
        <details class="oska-footer-column" open>
          <summary>{% if tr %}YARDIM{% else %}HELP{% endif %}<span aria-hidden="true">+</span></summary>
          <div class="oska-footer-column__links"><a href="/pages/contact">{% if tr %}İletişim{% else %}Contact{% endif %}</a><a href="/pages/contact-rfq">{% if tr %}Teklif Talebi{% else %}Request a Quote{% endif %}</a></div>
        </details>
        <details class="oska-footer-column" open>
          <summary>{% if tr %}HİZMETLER{% else %}SERVICES{% endif %}<span aria-hidden="true">+</span></summary>
          <div class="oska-footer-column__links"><a href="/pages/private-label">Private Label</a><a href="/pages/manufacturing">{% if tr %}Üretim Hizmetleri{% else %}Manufacturing Services{% endif %}</a><a href="/pages/contact-rfq">{% if tr %}Numune / Teklif{% else %}Sampling / Quotation{% endif %}</a></div>
        </details>
        <details class="oska-footer-column" open>
          <summary>{% if tr %}KOLEKSİYONLAR{% else %}COLLECTIONS{% endif %}<span aria-hidden="true">+</span></summary>
          <div class="oska-footer-column__links"><a href="/pages/oska-signature">OSKA Signature</a><a href="/pages/collections">{% if tr %}Tüm Koleksiyonlar{% else %}All Collections{% endif %}</a><a href="/pages/women-collections">{% if tr %}Kadın{% else %}Women{% endif %}</a><a href="/pages/men-collections">{% if tr %}Erkek{% else %}Men{% endif %}</a></div>
        </details>
        <details class="oska-footer-column" open>
          <summary>{% if tr %}ÜRETİM{% else %}MANUFACTURING{% endif %}<span aria-hidden="true">+</span></summary>
          <div class="oska-footer-column__links"><a href="/pages/manufacturing">{% if tr %}Atölyemiz{% else %}Our Atelier{% endif %}</a><a href="/pages/manufacturing">925 Silver · Brass · CAD</a><a href="/pages/private-label">{% if tr %}Markalar İçin Üretim{% else %}Production for Brands{% endif %}</a></div>
        </details>
        <details class="oska-footer-column" open>
          <summary>{% if tr %}ŞİRKETİMİZ{% else %}OUR COMPANY{% endif %}<span aria-hidden="true">+</span></summary>
          <div class="oska-footer-column__links"><a href="/pages/about">{% if tr %}Hakkımızda{% else %}About OSKA{% endif %}</a><a href="/pages/contact">{% if tr %}İletişim{% else %}Contact{% endif %}</a><a href="/pages/private-label">B2B</a></div>
        </details>
      </div>

      <aside class="oska-premium-footer__follow" aria-label="{% if tr %}Bizi takip edin{% else %}Follow us{% endif %}">
        <strong>{% if tr %}BİZİ TAKİP EDİN{% else %}FOLLOW US{% endif %}</strong>

        <div class="oska-premium-footer__socials">
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">{% else %}<span aria-label="Instagram">{% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
          {% if section.settings.instagram_url != blank %}</a>{% else %}</span>{% endif %}

          {% if section.settings.pinterest_url != blank %}<a href="{{ section.settings.pinterest_url }}" aria-label="Pinterest" target="_blank" rel="noopener">{% else %}<span aria-label="Pinterest">{% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.2 17.4c-.1-1.5 0-3.3.4-4.8l1.2-5.1s-.3-.7-.3-1.8c0-1.7 1-3 2.2-3 1 0 1.5.8 1.5 1.8 0 1.1-.7 2.6-1 4-.6 1.8.9 3.2 2.7 3.2 3.2 0 5-4.1 5-7.1 0-2.9-2.3-5.1-6.4-5.1-4.7 0-7.6 3.5-7.6 7.4 0 1.3.4 2.3 1 3 .3.3.3.4.2.8l-.3 1.2c-.1.4-.5.5-.9.4-2.5-1-3.8-6.9-6.9 0-5.2 3.6-8.4 10.2-8.4 5.4 0 8.9 3.9 8.9 9 0 5.9-3.3 10.3-8.1 10.3-1.6 0-3.1-.9-3.6-1.9l-1 3.8c-.4 1.4-1.1 2.8-1.8 3.8A12 12 0 1 0 12 3z" transform="scale(.82) translate(2.6 2.6)"></path></svg>
          {% if section.settings.pinterest_url != blank %}</a>{% else %}</span>{% endif %}

          {% if section.settings.linkedin_url != blank %}<a href="{{ section.settings.linkedin_url }}" aria-label="LinkedIn" target="_blank" rel="noopener">{% else %}<span aria-label="LinkedIn">{% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8.5V20M5 4.8v.2M10 20V9h4v1.7c1-1.4 2.3-2.2 4-2.2 3.1 0 4 2.1 4 5V20"></path></svg>
          {% if section.settings.linkedin_url != blank %}</a>{% else %}</span>{% endif %}

          {% if section.settings.youtube_url != blank %}<a href="{{ section.settings.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener">{% else %}<span aria-label="YouTube">{% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3"></rect><path d="M10 9l5 3-5 3z"></path></svg>
          {% if section.settings.youtube_url != blank %}</a>{% else %}</span>{% endif %}

          {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener">{% else %}<span aria-label="TikTok">{% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.1a4.1 4.1 0 1 1-3.4-4.04"></path><path d="M14 4c.6 2.2 2 3.6 4 4"></path></svg>
          {% if section.settings.tiktok_url != blank %}</a>{% else %}</span>{% endif %}

          {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener">{% else %}<span aria-label="Facebook">{% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h3l.5-3H14V8.3c0-.9.3-1.6 1.8-1.6H18V4.1c-.4-.1-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5V10H8v3h3v8"></path></svg>
          {% if section.settings.facebook_url != blank %}</a>{% else %}</span>{% endif %}
        </div>

        {% if section.settings.whatsapp_url != blank %}
          <a class="oska-premium-footer__whatsapp" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        {% else %}
          <span class="oska-premium-footer__whatsapp is-disabled" aria-label="WhatsApp">
        {% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a8 8 0 0 1-11.8 7l-4.2 1.1 1.1-4A8 8 0 1 1 20 11.7z"></path><path d="M8.4 8.1c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.3.1.5-.1.7l-.6.7c-.2.2-.2.4-.1.6.4.8 1 1.5 1.8 2 .2.2.5.2.7 0l.8-.9c.2-.2.5-.3.7-.1l1.8.9c.3.1.4.3.4.6 0 .6-.3 1.4-.8 1.8-.6.5-1.4.8-2.2.6-1.4-.3-2.8-1-4-2-1.2-1-2.1-2.2-2.7-3.5-.5-1.2-.5-2.4.2-3.3z"></path></svg>
            <span>{% if tr %}WHATSAPP'TAN YAZIN{% else %}MESSAGE US ON WHATSAPP{% endif %}</span>
        {% if section.settings.whatsapp_url != blank %}</a>{% else %}</span>{% endif %}
      </aside>
    </div>

    <div class="oska-premium-footer__rule"></div>
    <div class="oska-premium-footer__legal">
      <nav aria-label="{% if tr %}Yasal bağlantılar{% else %}Legal links{% endif %}">
        {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">{% if tr %}Gizlilik Politikası{% else %}Privacy Policy{% endif %}</a>{% endif %}
        {% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">{% if tr %}Kullanım Şartları{% else %}Terms of Use{% endif %}</a>{% else %}<span class="is-pending">{% if tr %}Kullanım Şartları{% else %}Terms of Use{% endif %}</span>{% endif %}
        <a href="/sitemap.xml">{% if tr %}Site Haritası{% else %}Site Map{% endif %}</a>
        {% if section.settings.kvkk_url != blank %}<a href="{{ section.settings.kvkk_url }}">KVKK / {% if tr %}Çerezler{% else %}Cookies{% endif %}</a>{% else %}<span class="is-pending">KVKK / {% if tr %}Çerezler{% else %}Cookies{% endif %}</span>{% endif %}
      </nav>
      <div class="oska-premium-footer__meta"><span>© 2026 OSKA</span><span>Istanbul · Türkiye</span>{% form 'localization', class:'oska-premium-footer__language' %}{% for language in localization.available_languages %}<button type="submit" name="locale_code" value="{{ language.iso_code }}"{% if language.iso_code == request.locale.iso_code %} aria-current="true"{% endif %}>{{ language.endonym_name }}</button>{% unless forloop.last %}<i aria-hidden="true">/</i>{% endunless %}{% endfor %}{% endform %}</div>
    </div>
  </div>
</footer>
<script>
(function(){
  var mq=window.matchMedia('(max-width:820px)');
  var sync=function(){
    document.querySelectorAll('.oska-footer-column').forEach(function(d){
      if(mq.matches){ d.removeAttribute('open'); }
      else { d.setAttribute('open',''); }
    });
  };
  sync();
  if(mq.addEventListener){mq.addEventListener('change',sync);}else if(mq.addListener){mq.addListener(sync);}
})();
</script>
{% schema %}{"name":"OSKA Footer","settings":[{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"url","id":"pinterest_url","label":"Pinterest URL"},{"type":"url","id":"linkedin_url","label":"LinkedIn URL"},{"type":"url","id":"youtube_url","label":"YouTube URL"},{"type":"url","id":"tiktok_url","label":"TikTok URL"},{"type":"url","id":"facebook_url","label":"Facebook URL"},{"type":"url","id":"whatsapp_url","label":"WhatsApp URL"},{"type":"url","id":"kvkk_url","label":"KVKK / Cookie page URL"}]}{% endschema %}