{% liquid
  assign brand_name = 'OSKA'
  assign tr = false
  if request.locale.iso_code == 'tr'
    assign tr = true
  endif

  if tr
    assign default_title = 'OSKA | B2B Takı Tasarım & Üretim'
    assign default_description = 'OSKA İstanbul merkezli B2B takı tasarım, private label ve üretim kataloğu. 925 gümüş, pirinç/bronz, CAD, numune ve markalara özel üretim.'
  else
    assign default_title = 'OSKA | B2B Jewelry Design & Manufacturing'
    assign default_description = 'OSKA is an Istanbul-based B2B jewelry design, private-label and manufacturing catalogue for 925 silver, brass/bronze, CAD, sampling and brand production.'
  endif

  assign seo_title = blank
  assign seo_description = blank

  if request.page_type == 'page'
    case page.handle
      when 'collections'
        if tr
          assign seo_title = 'OSKA Koleksiyonları | B2B Takı Kataloğu'
          assign seo_description = 'OSKA kadın ve erkek takı koleksiyonlarını keşfedin. Yüzük, bileklik, kolye ve küpe modelleri; B2B üretim, private label ve numune seçenekleri.'
        else
          assign seo_title = 'OSKA Collections | B2B Jewelry Catalogue'
          assign seo_description = 'Explore OSKA women’s and men’s jewelry collections across rings, bracelets, necklaces and earrings, with B2B manufacturing, private label and sampling.'
        endif
      when 'manufacturing'
        if tr
          assign seo_title = 'Takı Üretimi | 925 Gümüş, Pirinç & CAD | OSKA'
          assign seo_description = 'İstanbul’da 925 gümüş, pirinç/bronz, CAD, taşlı üretim, numune ve markalara özel takı üretimi. OSKA B2B üretim kabiliyetlerini inceleyin.'
        else
          assign seo_title = 'Jewelry Manufacturing | 925 Silver, Brass & CAD | OSKA'
          assign seo_description = 'Istanbul-based B2B jewelry manufacturing in 925 silver and brass/bronze, with CAD, stone setting, sampling and private-label production.'
        endif
      when 'private-label'
        if tr
          assign seo_title = 'Private Label Takı Üretimi | OSKA'
          assign seo_description = 'Markanız için özel takı geliştirme: tasarım, CAD, numune, 925 gümüş, pirinç/bronz, kaplama, taş ve B2B üretim desteği.'
        else
          assign seo_title = 'Private Label Jewelry Manufacturing | OSKA'
          assign seo_description = 'Develop jewelry for your brand with OSKA: design, CAD, sampling, 925 silver, brass/bronze, plating, stones and B2B manufacturing support.'
        endif
      when 'about'
        if tr
          assign seo_title = 'OSKA Hakkında | İstanbul Takı Tasarım & Üretim'
          assign seo_description = 'OSKA’nın İstanbul merkezli takı tasarım, zanaat ve B2B üretim yaklaşımını keşfedin.'
        else
          assign seo_title = 'About OSKA | Istanbul Jewelry Design & Manufacturing'
          assign seo_description = 'Discover OSKA’s Istanbul-based approach to jewelry design, craftsmanship and B2B manufacturing.'
        endif
      when 'contact-rfq'
        if tr
          assign seo_title = 'Takı Üretim Teklifi & Numune Talebi | OSKA'
          assign seo_description = 'OSKA’dan B2B takı üretimi, private label, numune ve fiyat teklifi talep edin. Model, materyal, adet ve hedef pazar bilgilerinizi paylaşın.'
        else
          assign seo_title = 'Jewelry Manufacturing RFQ & Sampling | OSKA'
          assign seo_description = 'Request a B2B jewelry manufacturing quotation or sample from OSKA. Share your model, material, quantity and target market.'
        endif
      when 'contact'
        if tr
          assign seo_title = 'OSKA İletişim | B2B Takı Üretimi'
          assign seo_description = 'OSKA ile koleksiyon, üretim, private label, numune ve B2B iş birlikleri için iletişime geçin.'
        else
          assign seo_title = 'Contact OSKA | B2B Jewelry Manufacturing'
          assign seo_description = 'Contact OSKA for collections, manufacturing, private label, sampling and B2B jewelry partnerships.'
        endif
      when 'women-rings'
        if tr
          assign seo_title = 'Kadın Yüzükleri | B2B Takı Koleksiyonu | OSKA'
          assign seo_description = 'OSKA kadın yüzük koleksiyonlarını keşfedin. 925 gümüş, pirinç/bronz, taş ve farklı yüzey seçenekleriyle B2B üretime uygun tasarımlar.'
        else
          assign seo_title = 'Women’s Rings | B2B Jewelry Collection | OSKA'
          assign seo_description = 'Explore OSKA women’s ring collections designed for B2B production in 925 silver, brass/bronze, stones and custom finishes.'
        endif
      when 'women-bracelets'
        if tr
          assign seo_title = 'Kadın Bileklikleri | B2B Takı Koleksiyonu | OSKA'
          assign seo_description = 'OSKA kadın bileklik koleksiyonlarını keşfedin. Zincir, cuff, taşlı ve heykelsi tasarımlar; B2B üretim ve private label seçenekleri.'
        else
          assign seo_title = 'Women’s Bracelets | B2B Jewelry Collection | OSKA'
          assign seo_description = 'Explore OSKA women’s bracelet collections including chain, cuff, stone-set and sculptural designs for B2B and private label production.'
        endif
      when 'women-necklaces'
        if tr
          assign seo_title = 'Kadın Kolyeleri | B2B Takı Koleksiyonu | OSKA'
          assign seo_description = 'OSKA kadın kolye koleksiyonlarını keşfedin. B2B üretim, özel taş, kaplama ve private label geliştirme seçenekleri.'
        else
          assign seo_title = 'Women’s Necklaces | B2B Jewelry Collection | OSKA'
          assign seo_description = 'Explore OSKA women’s necklace collections with B2B manufacturing, custom stone, finish and private-label options.'
        endif
      when 'women-earrings'
        if tr
          assign seo_title = 'Kadın Küpeleri | B2B Takı Koleksiyonu | OSKA'
          assign seo_description = 'OSKA kadın küpe koleksiyonlarını keşfedin. Stud, hoop, drop ve özel tasarım seçenekleri; B2B ve private label üretime uygun.'
        else
          assign seo_title = 'Women’s Earrings | B2B Jewelry Collection | OSKA'
          assign seo_description = 'Explore OSKA women’s earrings across studs, hoops, drops and custom designs for B2B and private-label manufacturing.'
        endif
      when 'men-rings'
        if tr
          assign seo_title = 'Erkek Yüzükleri | Maskülen B2B Takı | OSKA'
          assign seo_description = 'OSKA erkek yüzük koleksiyonlarını keşfedin. Maskülen signet, figürlü, taşlı ve geometrik tasarımlar; 925 gümüş ve pirinç B2B üretim.'
        else
          assign seo_title = 'Men’s Rings | Masculine B2B Jewelry | OSKA'
          assign seo_description = 'Explore OSKA men’s ring collections including masculine signets, figural, stone-set and geometric designs for 925 silver and brass B2B production.'
        endif
      when 'men-bracelets'
        if tr
          assign seo_title = 'Erkek Bileklikleri | Maskülen B2B Takı | OSKA'
          assign seo_description = 'OSKA erkek bileklik koleksiyonlarını keşfedin. Link, cuff, taşlı, figürlü ve koyu metal tasarımlar; B2B üretim ve private label.'
        else
          assign seo_title = 'Men’s Bracelets | Masculine B2B Jewelry | OSKA'
          assign seo_description = 'Explore OSKA men’s bracelets across link, cuff, stone, figural and dark-metal designs for B2B and private-label production.'
        endif
      when 'men-necklaces'
        if tr
          assign seo_title = 'Erkek Kolyeleri | B2B Takı Koleksiyonu | OSKA'
          assign seo_description = 'OSKA erkek kolye koleksiyonlarını keşfedin. Zincir, pendant, tag, taş ve sembolik tasarımlar; 925 gümüş ve pirinç B2B üretim.'
        else
          assign seo_title = 'Men’s Necklaces | B2B Jewelry Collection | OSKA'
          assign seo_description = 'Explore OSKA men’s necklaces including chains, pendants, tags, stones and symbolic designs for 925 silver and brass B2B production.'
        endif
      when 'men-earrings'
        if tr
          assign seo_title = 'Erkek Küpeleri | B2B Takı Koleksiyonu | OSKA'
          assign seo_description = 'OSKA erkek küpe koleksiyonlarını keşfedin. Stud, hoop, taşlı, figürlü ve koyu metal tasarımlar; B2B üretime uygun.'
        else
          assign seo_title = 'Men’s Earrings | B2B Jewelry Collection | OSKA'
          assign seo_description = 'Explore OSKA men’s earrings across studs, hoops, stones, figural and dark-metal designs for B2B manufacturing.'
        endif
    endcase
  endif

  if seo_title == blank
    assign seo_title = page_title
    if request.page_type == 'index' or seo_title == blank or seo_title == shop.name
      assign seo_title = default_title
    elsif seo_title contains 'OSKA'
    else
      assign seo_title = seo_title | append: ' | OSKA'
    endif
  endif

  if seo_description == blank
    assign seo_description = page_description | default: default_description
  endif

  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  if request.page_type == 'article'
    assign og_type = 'article'
  endif
  assign fallback_og_image = 'oska-hero-poster.jpg' | asset_url
%}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<meta name="description" content="{{ seo_description | strip_html | strip_newlines | escape }}">
<link rel="canonical" href="{{ og_url }}">
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
<link rel="dns-prefetch" href="//cdn.shopify.com">

<title>{{ seo_title | escape }}</title>

<meta property="og:site_name" content="{{ brand_name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ seo_description | strip_html | strip_newlines | escape }}">
<meta property="og:locale" content="{% if tr %}tr_TR{% else %}en_US{% endif %}">

{% if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{% else %}
  <meta property="og:image" content="https:{{ fallback_og_image }}">
  <meta property="og:image:secure_url" content="https:{{ fallback_og_image }}">
{% endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | strip_html | strip_newlines | escape }}">
{% if page_image %}
  <meta name="twitter:image" content="https:{{ page_image | image_url }}">
{% else %}
  <meta name="twitter:image" content="https:{{ fallback_og_image }}">
{% endif %}

{% if request.page_type == 'search' or request.page_type == 'password' or request.page_type == 'cart' or request.page_type == '404' or page.handle == 'model-detail' %}
  <meta name="robots" content="noindex,follow">
{% else %}
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
{% endif %}